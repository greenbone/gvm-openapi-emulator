    "name": "Operating System (OS) Detection (ICMP)",
    "filename": "os_fingerprint.nasl",
    "tag": {
      "creation_date": 1242727550,
      "cvss_base_vector": "AV:N/AC:L/Au:N/C:N/I:N/A:N",
      "insight": "This script performs ICMP based OS fingerprinting (as\n  described by Ofir Arkin and Fyodor Yarochkin in Phrack #57). It can be used to determine\n  the remote OS and partly it's version.\n\n  Note: This routine / method is false positive prone (especially in virtualized\n  environments) and only the last resort if any other OS detection method is failing). Due\n  to this it is possible to disable this routine via the script preferences.",
      "last_modification": 1791560456,
      "qod_type": "remote_analysis",
      "summary": "ICMP based OS fingerprinting / detection."
    },
    "dependencies": [
      "gb_test.nasl"
    ],
