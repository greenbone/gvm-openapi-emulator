@baseUrl = http://localhost:8086
@resetToken = local-agent-reset
@agentId = test::2d61a736

### Exact profile provenance
GET {{baseUrl}}/_emulator/agent-control/provenance

### Paginated deterministic inventory
GET {{baseUrl}}/api/v1/admin/agents?page=1&per_page=2

### Protected per-agent configuration
GET {{baseUrl}}/api/v1/agents/{{agentId}}/config
Authorization: Bearer local-profile-token

### Atomic grouped mutation
PATCH {{baseUrl}}/api/v1/admin/agents
Content-Type: application/json

{
  "test::2d61a736": {
    "authorized": true,
    "update_to_latest": false
  },
  "test::123123": {
    "min_interval": 120
  }
}

### Scan-agent configuration read
GET {{baseUrl}}/api/v1/admin/scan-agent-config

### Scan-agent configuration update
PUT {{baseUrl}}/api/v1/admin/scan-agent-config
Content-Type: application/json

{
  "agent_control_defaults": {
    "update_to_latest": false
  },
  "agent_defaults": {
    "heartbeat": {
      "interval_in_seconds": 30
    }
  }
}

### Deterministic support bundle
GET {{baseUrl}}/agent-control/v2/api/agents/{{agentId}}/support-bundle?days=3&encryption=false

### Agent-backed scan
POST {{baseUrl}}/scans
Content-Type: application/json

{
  "target": {
    "hosts": ["192.168.1.101"]
  },
  "vts": [
    {
      "oid": "1.3.6.1.4.1.25623.1.0.103997"
    }
  ]
}

### Named unavailable failure
GET {{baseUrl}}/api/v1/admin/agents
X-Emulator-Scenario: unavailable

### Restore the declared seed and deterministic counters
POST {{baseUrl}}/_emulator/agent-control/reset
X-Emulator-Reset-Token: {{resetToken}}
Content-Type: application/json

{}
